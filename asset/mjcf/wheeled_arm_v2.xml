                  <!-- Training USD has a negative principal inertia (-0.0001007608).
                       Retain the existing repair: I_MJCF = I_USD + 0.001*Identity (kg*m^2). -->
                  <inertial pos="-8.6993e-05 -0.00012256 0.051431" quat="0.509059 0.823675 -0.131346 -0.212523" mass="0.5" diaginertia="0.249101 0.249 0.000899234"/>
