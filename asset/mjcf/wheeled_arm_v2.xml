        <joint name="HipR" pos="0 0 0" axis="0 0 -1" range="-3.14 3.14" actuatorfrcrange="-120 120"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HipR"/>
        <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="HipR"/>
        <body name="KneeR" pos="0.282 0 -0.0467" quat="0 1 0 0">
