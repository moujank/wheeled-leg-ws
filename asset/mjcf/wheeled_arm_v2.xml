  <!-- Control order: HipL, HipR, KneeL, KneeR, HubL, HubR,
       Arm_R, Arm_Y1, Arm_Y2, Arm_P1, Arm_Y3, Arm_P2.
       These are final physical targets, NOT raw policy actions:
       legs: q_default + 0.25*action; wheels: 4*action; arm: q_folded + 0.15*action;
       then clip to the ctrlrange below. Hold targets for 4 physics steps (0.008 s).
       PhysX actual velocity limits (legs/wheels: 2*pi, arm: 2 rad/s) have no
       equivalent MJCF joint-speed constraint; ctrlrange is NOT a speed limit
       for position actuators. soft_joint_pos_limit_factor=0.9 is a reward
       threshold, not a reduction of the physical joint ranges.
       PGS iterations and solref do not map directly to PhysX solver settings. -->
  <actuator>
    <position name="HipL_pos" joint="HipL" kp="20" kv="1.5" ctrlrange="0.3 1.0" forcerange="-120 120"/>
    <position name="HipR_pos" joint="HipR" kp="20" kv="1.5" ctrlrange="-1.0 -0.3" forcerange="-120 120"/>
    <position name="KneeL_pos" joint="KneeL" kp="30" kv="1.5" ctrlrange="0.9 1.7" forcerange="-120 120"/>
    <position name="KneeR_pos" joint="KneeR" kp="30" kv="1.5" ctrlrange="-1.7 -0.9" forcerange="-120 120"/>
    <velocity name="HubL_vel" joint="HubL" kv="1.5" ctrlrange="-6 6" forcerange="-17 17"/>
    <velocity name="HubR_vel" joint="HubR" kv="1.5" ctrlrange="-6 6" forcerange="-17 17"/>
    <position name="Arm_R_pos" joint="Arm_R" kp="40" kv="6" ctrlrange="-2.8 2.8" forcerange="-27 27"/>
    <position name="Arm_Y1_pos" joint="Arm_Y1" kp="40" kv="6" ctrlrange="-1.4 1.4" forcerange="-27 27"/>
    <position name="Arm_Y2_pos" joint="Arm_Y2" kp="40" kv="6" ctrlrange="-1.4 1.4" forcerange="-27 27"/>
    <position name="Arm_P1_pos" joint="Arm_P1" kp="40" kv="6" ctrlrange="-1.4 1.4" forcerange="-27 27"/>
    <position name="Arm_Y3_pos" joint="Arm_Y3" kp="40" kv="6" ctrlrange="-1.4 1.4" forcerange="-27 27"/>
    <position name="Arm_P2_pos" joint="Arm_P2" kp="40" kv="6" ctrlrange="-1.4 1.4" forcerange="-27 27"/>
  </actuator>
  <!-- Keep the reference leg sensor order; append arm position, velocity and actuator torque sensors. -->
  <sensor>
    <gyro name="imu_gyro" site="imu"/>
    <velocimeter name="imu_linear_velocity" site="imu"/>
    <accelerometer name="imu_linear_acceleration" site="imu"/>
    <framequat name="imu_orientation" objtype="site" objname="imu"/>
    <framepos name="imu_position" objtype="site" objname="imu"/>
    <framezaxis name="imu_upvector" objtype="site" objname="imu"/>
    <framelinvel name="imu_global_linvel" objtype="site" objname="imu"/>
    <frameangvel name="imu_global_angvel" objtype="site" objname="imu"/>
    <jointpos name="HipL_pos" joint="HipL"/>
    <jointvel name="HipL_vel" joint="HipL"/>
    <jointpos name="HipR_pos" joint="HipR"/>
    <jointvel name="HipR_vel" joint="HipR"/>
    <jointpos name="KneeL_pos" joint="KneeL"/>
    <jointvel name="KneeL_vel" joint="KneeL"/>
    <jointpos name="KneeR_pos" joint="KneeR"/>
    <jointvel name="KneeR_vel" joint="KneeR"/>
    <jointpos name="HubL_pos" joint="HubL"/>
    <jointvel name="HubL_vel" joint="HubL"/>
    <jointpos name="HubR_pos" joint="HubR"/>
    <jointvel name="HubR_vel" joint="HubR"/>
    <actuatorfrc name="HipL_torque" actuator="HipL_pos"/>
    <actuatorfrc name="HipR_torque" actuator="HipR_pos"/>
    <actuatorfrc name="KneeL_torque" actuator="KneeL_pos"/>
    <actuatorfrc name="KneeR_torque" actuator="KneeR_pos"/>
    <actuatorfrc name="HubL_torque" actuator="HubL_vel"/>
    <actuatorfrc name="HubR_torque" actuator="HubR_vel"/>
    <jointpos name="Arm_R_pos" joint="Arm_R"/>
    <jointvel name="Arm_R_vel" joint="Arm_R"/>
    <jointpos name="Arm_Y1_pos" joint="Arm_Y1"/>
    <jointvel name="Arm_Y1_vel" joint="Arm_Y1"/>
    <jointpos name="Arm_Y2_pos" joint="Arm_Y2"/>
    <jointvel name="Arm_Y2_vel" joint="Arm_Y2"/>
    <jointpos name="Arm_P1_pos" joint="Arm_P1"/>
    <jointvel name="Arm_P1_vel" joint="Arm_P1"/>
    <jointpos name="Arm_Y3_pos" joint="Arm_Y3"/>
    <jointvel name="Arm_Y3_vel" joint="Arm_Y3"/>
    <jointpos name="Arm_P2_pos" joint="Arm_P2"/>
    <jointvel name="Arm_P2_vel" joint="Arm_P2"/>
    <actuatorfrc name="Arm_R_torque" actuator="Arm_R_pos"/>
    <actuatorfrc name="Arm_Y1_torque" actuator="Arm_Y1_pos"/>
    <actuatorfrc name="Arm_Y2_torque" actuator="Arm_Y2_pos"/>
    <actuatorfrc name="Arm_P1_torque" actuator="Arm_P1_pos"/>
    <actuatorfrc name="Arm_Y3_torque" actuator="Arm_Y3_pos"/>
    <actuatorfrc name="Arm_P2_torque" actuator="Arm_P2_pos"/>
    <!-- Isaac base_lin_vel uses base-link COM velocity in the base frame. -->
    <velocimeter name="base_com_linvel" site="base_com"/>
  </sensor>
  <keyframe>
    <!-- Explicitly reset to home before stepping. qpos follows the body tree;
         ctrl follows actuator order. Zero raw actions hold the folded reference. -->
    <key name="home" qpos="0 0 0.58 1 0 0 0 0.65 1.3 0 -0.65 -1.3 0 0 -0.65 1.2 0 0 0"
         ctrl="0.65 -0.65 1.3 -1.3 0 0 0 -0.65 1.2 0 0 0"/>
  </keyframe>
</mujoco>
