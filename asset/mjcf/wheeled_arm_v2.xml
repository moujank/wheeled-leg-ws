<?xml version="1.0"?>
<mujoco model="wheeled_arm_v2">
  <!-- Nominal v2_wheeled_arm_v1 PLAY asset: WHEELED_ARM_CFG + ActionsCfg.
       Training mass/material/reset randomization is not baked into this model.
       Original STL collision meshes are retained; robot self-collisions are disabled.
       USD mass/COM/inertia and rest frames were checked; see the two inertia
       exceptions on Arm_Y3 and Arm_P2 below. -->
  <compiler angle="radian" meshdir="../wheeled_arm_v2/meshes" autolimits="true" eulerseq="xyz"/>
  <option timestep="0.002" iterations="50" solver="PGS" gravity="0 0 -9.81" integrator="implicitfast">
    <flag frictionloss="enable"/>
  </option>
  <visual>
    <quality shadowsize="4096"/>
    <map znear="0.05"/>
  </visual>
  <default>
    <!-- USD joint armature/friction are zero. Drive damping belongs in the
         actuator so the complete PD torque is saturated and reported by actuatorfrc. -->
    <joint damping="0" frictionloss="0" armature="0"/>
    <!-- Visual meshes override collision filtering. Robot collision meshes use
         contype=2/conaffinity=1; the ground uses the inverse pair. -->
    <!-- Nominal PLAY scene friction is 1.0. No additional rolling/torsional friction.
         solref is a MuJoCo approximation, not an equivalent PhysX setting;
         0.004 s is the refsafe minimum at dt=0.002. -->
    <geom condim="3" contype="2" conaffinity="1" solref="0.004 2" friction="1 0 0"/>
    <equality solref="0.004 2"/>
    <general ctrllimited="true" forcelimited="true" gear="1"/>
  </default>
  <statistic meansize="0.164352" extent="1.1084" center="0 0 0"/>
